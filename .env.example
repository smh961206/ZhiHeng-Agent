# 密钥仅由 Node.js 后端读取。不要放进 VITE_ 变量。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
# 填入账户可用且支持 function calling 的模型 ID
LLM_MODEL=deepseek-v4-pro
# 可选：路径语义判断模型；留空复用 LLM_MODEL，只选择路径、不开展研究。
LLM_ROUTER_MODEL=
# Vision 默认复用上面的接口和密钥，需要单独配置时填写以下两项。
LLM_VISION_API_KEY=
LLM_VISION_BASE_URL=https://api.deepseek.com
LLM_VISION_MODEL=deepseek-v4-flash-vision-exp
# auto：仅对已确认支持的 deepseek-v4-flash-vision-exp 启用图片；off 关闭。
# 其他已验证支持 image_url 的兼容服务可显式设 images。PDF 以原页图片读取。
LLM_VISION_INPUT=auto
LLM_TIMEOUT_MS=300000
# 审计输出：auto优先严格JSON Schema，接口明确不支持时兼容JSON/text。
# 可显式选择json_schema、json_object或text；不影响草稿与工具调用。
LLM_REVIEW_FORMAT=auto
PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=zhiheng_agent
# SEC自动访问标识：应用名 + 你的真实联系邮箱（不发送到模型或前端）
SEC_USER_AGENT=
# 可选：配置后补充三市场结构化财务数据，权限由Tushare账户决定。
TUSHARE_TOKEN=
# 可选：三项均填写后优先使用长桥行情及基本面；不调用交易接口。
LONGBRIDGE_APP_KEY=
LONGBRIDGE_APP_SECRET=
LONGBRIDGE_ACCESS_TOKEN=
# 网页补充：Tavily优先，Brave可选备用；只外发公开研究关键词。
# 未填搜索密钥时保留资料缺口，固定行情和财报采集照常运行。
WEB_SEARCH_ENABLED=true
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
# 可选：经你确认的公司官方域名，按证券绑定；搜索结果不能自行取得官方身份。
# 示例：{"US:AAPL":["apple.com"],"HK:00700":["tencent.com"]}
WEB_RESEARCH_ISSUER_DOMAINS={}
# 桌面网络若将公开域名映射为198.18/15保留地址，使用Cloudflare公共DNS校验真实公网地址。
# 设为false可关闭；不会直接允许内网或保留地址。
WEB_RESEARCH_PUBLIC_DNS=true
