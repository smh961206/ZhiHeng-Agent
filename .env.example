# 本地基础配置模板
# 先复制 config/models.example.json 为 config/models.local.json，按需编辑模型与连接。
MODEL_CONFIG_FILE=./config/models.local.json
# 新建环境时复制为 .env，再填写自己的密钥。已有 .env 请按需对照，不要整份覆盖。
# 高级参数可参考 .env.models.example，另存为 .env.models 后由对应启动入口自动加载（可选）。
# 基础与高级文件不要重复定义同名变量；示例文件本身不自动加载。
# 密钥仅供后端使用，不要放入 VITE_ 变量或提交到版本库。

# ── 01 · 服务与访问 ──
# 本地端口／数据库与生产访问参数按各自文件保留。
# 本地后端监听端口。
PORT=3001
# 本地 MongoDB 连接地址；凭据仅在后端使用。
MONGODB_URI=mongodb://127.0.0.1:27017
# 研究记录使用的数据库名称。
MONGODB_DATABASE=zhiheng_agent

# ── 02 · 模型访问凭据 ──
# 型号、接口、角色与能力统一在 MODEL_CONFIG_FILE 指定的 JSON 中配置。
# 默认模型凭据；JSON 通过 apiKeyEnv 显式引用。
LLM_API_KEY=
# 可选独立视觉凭据；使用时将视觉 connection 的 apiKeyEnv 改为此名称。
LLM_VISION_API_KEY=

# ── 05 · 运行方式与请求限制 ──
# 运行模式与能力验收是两回事，填写候选模型不会自动启用。
# legacy 固定；dry-run 只观察；policy 分层；champion 任务优选。
# policy／champion 需要匹配的真实验收与审批，未准入时回落 legacy。
MODEL_ROUTING_MODE=legacy
# true 保存调用元数据；false 关闭。均不保存提示词或隐藏推理正文。
MODEL_TELEMETRY_ENABLED=true
# 无有效内容等待上限，单位毫秒。
LLM_TIMEOUT_MS=300000
# 单次模型请求总时限，单位毫秒，持续生成也受此限制。
LLM_MAX_DURATION_MS=1800000
# 审计格式：auto 优先 JSON Schema，不支持时兼容；也可选 json_schema／json_object／text。
LLM_REVIEW_FORMAT=auto

# ── 06 · 证券与财报资料 ──
# 资料权限由各服务账户决定；未获得的数据保留为缺口。
# SEC 自动访问标识：应用名和真实联系邮箱，仅用于资料访问。
SEC_USER_AGENT=
# 可选；补充三市场结构化财务等资料。
TUSHARE_TOKEN=
# 长桥应用标识；下列三项均填写后使用长桥行情及基本面能力。
LONGBRIDGE_APP_KEY=
# 长桥应用密钥；本平台不调用交易接口。
LONGBRIDGE_APP_SECRET=
# 长桥访问令牌。
LONGBRIDGE_ACCESS_TOKEN=

# ── 07 · 网页检索与来源校验 ──
# 按资料缺口检索公开信息，不将搜索命中直接视为官方证据。
# true 开启网页补充；false 关闭，不影响固定行情和财报采集。
WEB_SEARCH_ENABLED=true
# 可选；Tavily 作为优先搜索服务。
TAVILY_API_KEY=
# 可选；Brave 作为备用搜索服务。
BRAVE_SEARCH_API_KEY=
# 已确认的公司官方域名，按证券绑定的 JSON 对象；没有补充时保留 {}。
WEB_RESEARCH_ISSUER_DOMAINS={}
# true 在必要时通过公共 DNS 校验公网地址；false 关闭此辅助校验。
# 不会因此允许访问内网或保留地址。
WEB_RESEARCH_PUBLIC_DNS=true

# ── 08 · 高级模型凭据与策略 ──
# 模型、接口、能力及候选角色在 config/models.local.json 中定义。
# 每个 connection 通过 apiKeyEnv 显式引用所需凭据。
LLM_MAIN_API_KEY=
LLM_PRO_API_KEY=
MODEL_POLICY_ACCEPTANCE_FILE=
LLM_VISION_CHALLENGER_API_KEY=
FEATURE_VISION_ROUTING=false
VISION_ACCEPTANCE_FILE=
LLM_MAIN_CHALLENGER_API_KEY=
# 以下发布开关不替代质量验收和人工批准。
MODEL_CHAMPION_ENABLED=false
MODEL_AB_ENABLED=false
MODEL_CHAMPION_REGISTRY_FILE=./data/model-champions.json
MODEL_CHAMPION_POLICY_VERSION=
MODEL_CHAMPION_INVALIDATION_FILE=
