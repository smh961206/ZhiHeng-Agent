# Copy to .env.production and fill the model settings. Never commit secrets.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# dry-run 仅记录候选；policy 须通过真实质量准入，否则保持 legacy。遥测仅保存调用元数据。
MODEL_ROUTING_MODE=legacy
MODEL_TELEMETRY_ENABLED=true
# 可选：路径语义判断模型；留空复用 LLM_MODEL，只选择路径、不开展研究。
LLM_ROUTER_MODEL=
LLM_VISION_API_KEY=
LLM_VISION_BASE_URL=https://api.deepseek.com
LLM_VISION_MODEL=deepseek-flash
# V4.9 候选视觉模型：默认关闭；仅在确认接口支持图片后将 INPUT 设为 images。
LLM_VISION_CHALLENGER_MODEL=glm-5.3-flash
LLM_VISION_CHALLENGER_PROVIDER=zai
LLM_VISION_CHALLENGER_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
LLM_VISION_CHALLENGER_API_KEY=
LLM_VISION_CHALLENGER_INPUT=images
# omit 不发送思考参数；disabled 仅用于已确认兼容显式关闭思考的服务。
LLM_VISION_CHALLENGER_THINKING=omit
FEATURE_VISION_ROUTING=false
# 真实对照及人工审核的批准文件路径；Docker 中须为容器可读路径，建议只读挂载。
# 示例路径不会自动挂载宿主机文件；启用前须配置只读挂载并核对容器内路径。
VISION_ACCEPTANCE_FILE=./vision_acceptance_file/vision-acceptance-glm53-fields-20260911-approved.json
# auto 识别 deepseek-flash；off 关闭；images 显式启用兼容图片接口。
LLM_VISION_INPUT=auto
# 模型连接连续无内容或标准保活心跳的等待上限。
LLM_TIMEOUT_MS=300000
# 每次模型请求的总时限，持续生成也不能超过此值。
LLM_MAX_DURATION_MS=1800000
# auto优先严格JSON Schema；明确不支持时兼容JSON/text。
LLM_REVIEW_FORMAT=auto
SEC_USER_AGENT=
# Optional data providers; credentials stay on the server.
TUSHARE_TOKEN=
LONGBRIDGE_APP_KEY=
LONGBRIDGE_APP_SECRET=
LONGBRIDGE_ACCESS_TOKEN=
# Supplemental web evidence; search keys never reach the model or browser.
WEB_SEARCH_ENABLED=true
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
WEB_RESEARCH_ISSUER_DOMAINS={}
WEB_RESEARCH_PUBLIC_DNS=true
# Default: access through SSH tunnel or an authenticated HTTPS reverse proxy.
BIND_ADDRESS=127.0.0.1
APP_PORT=3001
# Add exact browser-facing origins when using a reverse proxy, comma separated.
PUBLIC_ORIGINS=

# V4.8 policy stays disabled until a real >=50-case quality report is approved.
# MODEL_ROUTING_MODE=legacy remains the immediate rollback setting.
# MAIN: glm-5.3-flash (Z.ai); PRO: deepseek-flash (DeepSeek). No paid tests enabled here.
LLM_MAIN_MODEL=glm-5.3-flash
LLM_MAIN_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
LLM_MAIN_API_KEY=
LLM_PRO_MODEL=deepseek-flash
# Empty PRO base/key reuse existing LLM_BASE_URL / LLM_API_KEY.
LLM_PRO_BASE_URL=https://api.deepseek.com
LLM_PRO_API_KEY=
MODEL_POLICY_ACCEPTANCE_FILE=./model_policy_acceptance_file
