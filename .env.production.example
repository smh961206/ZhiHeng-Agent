# 生产基础配置模板
# 先复制 config/models.example.json 为 config/models.production.json，按需编辑模型与连接。
MODEL_CONFIG_FILE=./config/models.production.json
# deploy.sh 通过 compose.models.yaml 将此文件只读挂载到容器。
# 新建部署时复制为 .env.production，填写生产凭据，按 DEPLOY.md 启动。
# 宿主机端口／访问来源在此配置；容器数据库／内部端口由 compose.production.yaml 定义。
# 密钥仅供后端使用，不要放入 VITE_ 变量或提交到版本库。

# ── 01 · 服务与访问 ──
# 本地端口／数据库与生产访问参数按各自文件保留。
# 生产宿主机监听地址；默认仅允许本机访问。
BIND_ADDRESS=127.0.0.1
# 生产宿主机映射端口；容器内端口由 compose.production.yaml 指定。
APP_PORT=3001
# 浏览器访问来源白名单：完整协议、域名及端口，多个来源用逗号分隔。
PUBLIC_ORIGINS=

# ── 02 · 模型访问凭据 ──
# 型号、接口、角色与能力统一在 MODEL_CONFIG_FILE 指定的 JSON 中配置。
# 默认模型凭据；JSON 通过 apiKeyEnv 显式引用。
LLM_API_KEY=
# 第二个模型凭据；由模型 JSON 的 apiKeyEnv 显式引用。
LLM_MAIN_API_KEY=

# ── 03 · 运行方式与请求限制 ──
# true 保存调用元数据；false 关闭。均不保存提示词或隐藏推理正文。
MODEL_TELEMETRY_ENABLED=true
# 单实例并发研究上限。
MAX_CONCURRENT_RESEARCH=3
# 请求正文、变更请求频率、普通 API 时限与任务租约续期边界。
MAX_REQUEST_BYTES=26214400
API_RATE_LIMIT_PER_MINUTE=120
API_TIMEOUT_SECONDS=30
MATERIAL_TIMEOUT_SECONDS=110
MAX_CONCURRENT_MATERIAL_READS=2
TASK_LEASE_SECONDS=60
# 结构化后端日志级别。
LOG_LEVEL=INFO
# 无有效内容等待上限，单位毫秒。
LLM_TIMEOUT_MS=300000
# 单次模型请求总时限，单位毫秒，持续生成也受此限制。
LLM_MAX_DURATION_MS=1800000

# ── 04 · 证券与财报资料 ──
# 资料权限由各服务账户决定；未获得的数据保留为缺口。
# SEC 自动访问标识：应用名和真实联系邮箱，仅用于资料访问。
SEC_USER_AGENT=
# 可选；补充三市场结构化财务等资料。
TUSHARE_TOKEN=
# 长桥应用标识；下列三项均填写后使用长桥行情及基本面能力。
LONGBRIDGE_APP_KEY=
# 长桥应用密钥；本平台不调用交易接口。
LONGBRIDGE_APP_SECRET=
# 长桥访问令牌。
LONGBRIDGE_ACCESS_TOKEN=

# ── 05 · 网页检索与来源校验 ──
# 按资料缺口检索公开信息，不将搜索命中直接视为官方证据。
# true 开启网页补充；false 关闭，不影响固定行情和财报采集。
WEB_SEARCH_ENABLED=true
# 可选；Tavily 作为优先搜索服务。
TAVILY_API_KEY=
# 可选；Brave 作为备用搜索服务。
BRAVE_SEARCH_API_KEY=
# 已确认的公司官方域名，按证券绑定的 JSON 对象；没有补充时保留 {}。
WEB_RESEARCH_ISSUER_DOMAINS={}

# ── 06 · 模型费用记录（可选） ──
# 完整教程：docs/cost-configuration-guide.md；JSON 字段说明：config/README.md。
# 可留空；启用费用估算时指向 pricing.production.json 的容器内路径。
# 私有 JSON 需显式只读挂载；空注册表/缺失价格保持“未知”，不会自动查询价格。
MODEL_PRICING_FILE=

# 可选研究资源账本。生产启用前先在 dry-run 核对实际调用分布。
RESEARCH_BUDGET_FILE=./config/research-budget.example.json
RESEARCH_BUDGET_MODE=disabled
