{
  "name": "value-investment-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/backup-knowledge.mjs && vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "start:legacy": "node --env-file-if-exists=.env scripts/start-legacy.mjs",
    "knowledge:backup": "node scripts/backup-knowledge.mjs",
    "knowledge:index": "node scripts/index-knowledge.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:release": "node --test tests/harness.test.mjs tests/model-call-inventory.test.mjs tests/vision-call-inventory.test.mjs",
    "test:model-comparison": "node scripts/model-comparison.mjs",
    "test:mongodb": "node --env-file-if-exists=.env --test tests/storage.integration.mjs tests/schema.integration.mjs tests/jobs-delete.integration.mjs tests/jobs-retry.integration.mjs tests/jobs-delivery.integration.mjs tests/jobs-create.integration.mjs",
    "db:up": "docker compose up -d --wait",
    "db:stop": "docker compose stop mongodb",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate-mongodb.mjs",
    "test:routes": "node tests/routes.integration.mjs",
    "test:ui": "node tests/workspace-ui.integration.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.8",
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/chi_tra": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "0.8.2",
    "htmlparser2": "10.0.0",
    "longbridge": "4.5.0",
    "lucide-react": "^0.468.0",
    "mongodb": "^6.21.0",
    "pdfjs-dist": "^6.3.289",
    "radix-ui": "^1.6.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router": "^7.18.3",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tesseract.js": "7.0.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "vite": "^6.1.0"
  }
}
