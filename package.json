{
  "name": "value-investment-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:mongodb": "node --env-file-if-exists=.env --test tests/storage.integration.mjs tests/schema.integration.mjs",
    "db:up": "docker compose up -d --wait",
    "db:stop": "docker compose stop mongodb",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate-mongodb.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "mongodb": "^6.21.0",
    "pdfjs-dist": "^6.3.289",
    "radix-ui": "^1.6.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "vite": "^6.1.0"
  }
}
